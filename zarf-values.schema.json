{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "app": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resources": {
          "type": "object",
          "description": "Kubernetes resource requests and limits for the application container."
        },
        "storageSize": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$",
          "description": "Persistent storage allocated to the JSON demonstration data."
        },
        "podAnnotations": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" }
      },
      "required": ["resources", "storageSize", "podAnnotations", "nodeSelector", "tolerations", "affinity"]
    }
  },
  "required": ["app"]
}
